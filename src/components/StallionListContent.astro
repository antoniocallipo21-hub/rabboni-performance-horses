---
import Hero from './Hero.astro';
import StallionCard from './StallionCard.astro';
import { getStallions } from '../lib/stallions';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const stallions = await getStallions(lang);
---

<Hero lang={lang} title={t('stallions.title')} eyebrow={t('stallions.eyebrow')} />

<section class="stallions">
  <div class="container">
    {
      stallions.length > 0 ? (
        <div class="grid">
          {stallions.map((entry, i) => (
            <StallionCard entry={entry} lang={lang} delay={(i % 3) * 150} />
          ))}
        </div>
      ) : (
        <p class="empty">{t('stallions.empty')}</p>
      )
    }
  </div>
</section>

<style>
  .stallions {
    padding-block: clamp(3rem, 8vw, 6rem);
  }
  .grid {
    display: grid;
    gap: clamp(1.25rem, 2.4vw, 1.8rem);
    grid-template-columns: repeat(3, 1fr);
  }
  @media (max-width: 960px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  .empty {
    text-align: center;
    color: var(--gray);
    font-size: 1.1rem;
  }
</style>
