---
import { whmPath, whmSlug, type WhmEntry } from '../lib/whm';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  entry: WhmEntry;
  lang: Lang;
  delay?: number;
}

const { entry, lang, delay = 0 } = Astro.props;
const t = useTranslations(lang);
const { name, year, sex, color, breed, price, cover, coverAlt } = entry.data;
const href = whmPath(lang, whmSlug(entry));
const meta = [year, color, breed].filter(Boolean).join(' ');
---

<a
  class="wcard reveal"
  style={`--reveal-delay: ${delay}ms`}
  href={href}
  data-breed={breed ?? ''}
  data-color={color ?? ''}
  data-sex={sex ?? ''}
  data-year={year ?? ''}
>
  <span class="wcard__photo">
    <img src={cover} alt={coverAlt ?? ''} loading="lazy" />
    <span class="wcard__price">{price || t('whm.priceOnRequest')}</span>
  </span>
  <span class="wcard__body">
    {meta && <span class="wcard__meta">{meta}</span>}
    <span class="wcard__name">{name}</span>
  </span>
</a>

<style>
  .wcard {
    display: block;
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid #26221d;
    background: var(--ink);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s;
  }
  .wcard:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 44px rgba(0, 0, 0, 0.28);
  }
  .wcard__photo {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--sand);
  }
  .wcard__photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 20%;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .wcard:hover .wcard__photo img {
    transform: scale(1.045);
  }
  .wcard__price {
    position: absolute;
    top: 0.9rem;
    right: 0.9rem;
    padding: 0.4rem 0.8rem;
    background: var(--red);
    color: #fff;
    font-family: var(--font-display);
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    border-radius: 4px;
  }
  .wcard__body {
    display: block;
    padding: 1.15rem 1.1rem 1.3rem;
    text-align: center;
  }
  .wcard__meta {
    display: block;
    font-family: var(--font-nav);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--red);
  }
  .wcard__name {
    display: block;
    margin-top: 0.5rem;
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-weight: 500;
    font-size: 1.35rem;
    line-height: 1.15;
    color: #fff;
  }
</style>
