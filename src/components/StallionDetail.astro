---
import Hero from './Hero.astro';
import PedigreeTree from './PedigreeTree.astro';
import HorseGallery from './HorseGallery.astro';
import CtaBand from './CtaBand.astro';
import type { StallionEntry } from '../lib/stallions';
import { useTranslations, localePath, type Lang } from '../i18n/ui';

interface Props {
  entry: StallionEntry;
  lang: Lang;
}

const { entry, lang } = Astro.props;
const t = useTranslations(lang);
const d = entry.data;
const {
  name, nickname, year, color, registry, height,
  earnings, lte, titles,
  sireBio, damBio,
  fee, geneticStatus, semenAvailability, breedingLinks, foalsEligible, video,
  offspringEarnings, offspringExample,
  sire, dam, cover, coverAlt, cardCover, cardCoverAlt, logo, logoAlt, gallery,
} = d;
const cardPhoto = cardCover ?? cover;
const cardPhotoAlt = cardCoverAlt ?? coverAlt;

// Per ora non mostriamo l'anno di morte nel passaporto, solo l'anno di nascita.
const years = String(year ?? '');
// Hero: anno di nascita, colore e "Stallion" sempre in inglese, anche nella pagina italiana
// (è una dicitura da settore internazionale del reining, non tradotta), senza range di anni né pedigree.
const heroEyebrow = [year, color, 'Stallion'].filter(Boolean).join(' ');

// Il passaporto usa le diciture inglesi standard del settore, anche nella pagina italiana
// (stesso criterio già usato per "2011 Sorrel Stallion" nell'hero).
const passport = [
  { label: 'Breed', value: registry },
  { label: 'Color', value: color },
  { label: 'Born', value: years },
  { label: 'Height', value: height },
].filter((p) => p.value);

const hasBreedingInfo = fee || geneticStatus || semenAvailability || (breedingLinks && breedingLinks.length > 0) || foalsEligible;
const hasLines = sireBio || damBio;

// Accetta un indirizzo YouTube in vari formati, o un semplice ID, e ricava l'indirizzo da incorporare.
function youtubeEmbed(input?: string) {
  if (!input) return undefined;
  const idMatch = input.match(/(?:youtu\.be\/|v=|embed\/)([\w-]{11})/);
  const id = idMatch ? idMatch[1] : /^[\w-]{11}$/.test(input) ? input : undefined;
  return id ? `https://www.youtube-nocookie.com/embed/${id}` : undefined;
}
const videoEmbed = youtubeEmbed(video);
---

<div class="hero-wrap">
  <Hero lang={lang} title={name} eyebrow={heroEyebrow} subtitle={nickname ? `“${nickname}”` : undefined} imageUrl={cover} alt={coverAlt ?? ''} />
  {logo && <img class="hero-logo" src={logo} alt={logoAlt ?? `${name} logo`} loading="eager" />}
</div>

<section class="passport-section">
  <div class="container passport-grid">
    <img class="passport-photo" src={cardPhoto} alt={cardPhotoAlt ?? ''} />
    {passport.length > 0 && (
      <dl class="passport-facts">
        {passport.map((p) => (
          <div class="passport-facts__item">
            <dt>{p.label}</dt>
            <dd>{p.value}</dd>
          </div>
        ))}
      </dl>
    )}
  </div>
</section>

<article class="detail detail--cont">
  <div class="container detail__inner">
    {(lte || earnings) && (
      <p class="earnings">
        <span class="earnings__label">Lifetime Earnings</span>
        <strong class="earnings__value">{lte ?? earnings}</strong>
      </p>
    )}

    {titles && titles.length > 0 && (
      <ul class="titles">
        {titles.map((title) => <li>{title}</li>)}
      </ul>
    )}
  </div>
</article>

<PedigreeTree
  sire={d.sire} dam={d.dam}
  sireSire={d.sireSire} sireDam={d.sireDam} damSire={d.damSire} damDam={d.damDam}
  sireSireSire={d.sireSireSire} sireSireDam={d.sireSireDam} sireDamSire={d.sireDamSire} sireDamDam={d.sireDamDam}
  damSireSire={d.damSireSire} damSireDam={d.damSireDam} damDamSire={d.damDamSire} damDamDam={d.damDamDam}
/>

{
  hasLines && (
    <section class="lines">
      <div class="container lines__grid">
        {sireBio && (
          <div class="lines__col">
            <h2 class="block-title">{t('stallions.sire')}</h2>
            <p><strong>{sire}</strong>{sireBio.startsWith(sire ?? '\0') ? '' : ' — '}{sireBio}</p>
          </div>
        )}
        {damBio && (
          <div class="lines__col">
            <h2 class="block-title">{t('stallions.firstdam')}</h2>
            <p><strong>{dam}</strong>{damBio.startsWith(dam ?? '\0') ? '' : ' — '}{damBio}</p>
          </div>
        )}
      </div>
    </section>
  )
}

<HorseGallery images={gallery ?? []} name={name} lang={lang} />

{
  hasBreedingInfo && (
    <section class="breeding">
      <div class="container">
        <h2 class="block-title">{t('stallions.breeding')}</h2>
        {fee && <p class="breeding__price">{fee}</p>}
        {geneticStatus && <p class="breeding__line">{geneticStatus}</p>}
        {semenAvailability && <p class="breeding__line">{semenAvailability}</p>}
        {breedingLinks && breedingLinks.length > 0 && (
          <div class="breeding__links">
            {breedingLinks.map((l) => (
              <a href={l.url} target="_blank" rel="noopener noreferrer">{l.label} →</a>
            ))}
          </div>
        )}
        {foalsEligible && <p class="breeding__eligible">Foals Eligible for {foalsEligible}</p>}
      </div>
    </section>
  )
}

{
  videoEmbed && (
    <section class="video">
      <div class="container">
        <div class="video__frame">
          <iframe
            src={videoEmbed}
            title={`${name} — video`}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          />
        </div>
      </div>
    </section>
  )
}

{
  offspringEarnings && (
    <section class="offspring">
      <div class="container">
        <p class="earnings">
          <span class="earnings__label">Offspring Earnings</span>
          <strong class="earnings__value">{offspringEarnings}</strong>
        </p>
        {offspringExample && (
          <p class="offspring__example">
            <strong>{offspringExample.name}{offspringExample.lte && ` (LTE ${offspringExample.lte})`}</strong> — {offspringExample.note}
          </p>
        )}
      </div>
    </section>
  )
}

<CtaBand
  text={t('horses.cta.text')}
  buttonLabel={t('aboutpage.cta.button')}
  buttonHref={localePath(lang, '/contatti')}
/>

<style>
  .hero-wrap {
    position: relative;
  }
  .hero-logo {
    position: absolute;
    top: 50%;
    right: clamp(1.5rem, 5vw, 5rem);
    transform: translateY(-50%);
    width: clamp(200px, 22vw, 380px);
    height: auto;
    filter: drop-shadow(0 4px 18px rgba(0, 0, 0, 0.45));
    pointer-events: none;
  }
  @media (max-width: 720px) {
    .hero-logo {
      display: none;
    }
  }
  .detail {
    padding-block: clamp(3rem, 8vw, 6rem) 0;
  }
  .detail--cont {
    padding-top: 0;
  }
  .detail__inner {
    max-width: 760px;
  }

  .passport-section {
    padding-block: clamp(3rem, 8vw, 6rem);
  }
  .passport-grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    max-width: 900px;
    margin-inline: auto;
  }
  .passport-photo {
    display: block;
    width: 100%;
    max-width: 360px;
    aspect-ratio: 5 / 7;
    margin-inline: auto;
    object-fit: cover;
    object-position: 50% 15%;
    border-radius: 16px;
  }
  @media (min-width: 800px) {
    .passport-grid {
      grid-template-columns: minmax(240px, 320px) 1fr;
    }
    .passport-photo {
      max-width: none;
      margin-inline: 0;
    }
  }
  .passport-facts {
    margin: 0;
    border-top: 1px solid #e6e2dc;
  }
  .passport-facts__item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid #e6e2dc;
  }
  .passport-facts__item dt {
    color: var(--gray);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.75rem;
    font-weight: 600;
  }
  .passport-facts__item dd {
    margin: 0;
    text-align: right;
    font-family: var(--font-display);
    font-size: 1.2rem;
  }
  .block-title {
    margin: 0 0 1.25rem;
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-weight: 500;
    font-size: 1.4rem;
  }
  .earnings {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.6rem;
    margin: 0 0 clamp(2rem, 5vw, 3rem);
    text-align: center;
  }
  .earnings__label {
    color: var(--red);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.78rem;
    font-weight: 600;
  }
  .earnings__value {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 2.6rem);
  }
  .titles {
    margin: 0 0 clamp(2rem, 5vw, 3rem);
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }
  .titles li {
    padding-left: 1.1rem;
    position: relative;
    font-size: 0.98rem;
  }
  .titles li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 6px;
    height: 6px;
    background: var(--red);
  }
  .lines {
    padding-block: clamp(3rem, 8vw, 6rem);
  }
  .lines__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    position: relative;
  }
  .lines .block-title {
    display: inline-block;
    width: 6.5rem;
    white-space: nowrap;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid #e6e2dc;
  }
  .lines__col p {
    margin: 0;
    line-height: 1.75;
    color: #444;
  }
  @media (min-width: 800px) {
    .lines__grid {
      grid-template-columns: 1fr 1fr;
    }
    .lines__grid::before {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      left: 50%;
      width: 1px;
      background: #e6e2dc;
      transform: translateX(-50%);
    }
  }

  .breeding {
    padding-top: clamp(1.5rem, 4vw, 3rem);
    padding-bottom: clamp(3rem, 8vw, 6rem);
  }
  .breeding .block-title {
    text-align: center;
  }
  .breeding__price {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 600;
    text-align: center;
  }
  .breeding__line {
    margin: 0.5rem 0 0;
    text-align: center;
    color: var(--gray);
  }
  .breeding__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 1.5rem;
    margin-top: 1.75rem;
  }
  .breeding__links a {
    font-weight: 600;
    font-size: 0.92rem;
    letter-spacing: 0.02em;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .breeding__links a:hover {
    color: var(--red);
  }
  .breeding__eligible {
    margin: 1.75rem 0 0;
    text-align: center;
    font-size: 0.92rem;
    color: var(--gray);
  }

  .video {
    padding-block: clamp(3rem, 8vw, 6rem);
    background: var(--ink);
  }
  .video__frame {
    position: relative;
    max-width: 900px;
    margin-inline: auto;
    aspect-ratio: 16 / 9;
    background: #000;
  }
  .video__frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .offspring {
    padding-block: clamp(3rem, 8vw, 6rem);
  }
  .offspring .earnings {
    margin: 0;
  }
  .offspring__example {
    margin: 0.75rem 0 0;
    text-align: center;
    color: var(--gray);
  }

</style>
