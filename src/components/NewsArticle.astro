---
import Hero from './Hero.astro';
import NewsCard from './NewsCard.astro';
import { formatDate, getNews, newsPath, newsSlug, type NewsEntry } from '../lib/news';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  entry: NewsEntry;
  lang: Lang;
}

const { entry, lang } = Astro.props;
const t = useTranslations(lang);
const { title, date, category, cover, coverAlt } = entry.data;

const related = (await getNews(lang)).filter((e) => e.id !== entry.id).slice(0, 3);
---

<Hero
  lang={lang}
  title={title}
  eyebrow={`${t(`cat.${category}` as const)} · ${formatDate(date, lang)}`}
  imageUrl={cover}
  alt={coverAlt ?? ''}
/>

<article class="article">
  <div class="container article__inner">
    <div class="prose">
      <slot />
    </div>
    <a class="article__back" href={newsPath(lang)}>← {t('news.back')}</a>
  </div>
</article>

{
  related.length > 0 && (
    <section class="related">
      <div class="container">
        <h2 class="related__title reveal">{t('news.more')}</h2>
        <div class="related__grid">
          {related.map((e, i) => (
            <NewsCard entry={e} lang={lang} delay={i * 180} />
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .article {
    padding-block: clamp(3rem, 8vw, 6rem);
  }
  .article__inner {
    max-width: 760px;
  }
  .prose {
    font-size: 1.12rem;
    line-height: 1.85;
    color: #333;
  }
  .prose :global(p) {
    margin: 0 0 1.5rem;
  }
  .prose :global(h2),
  .prose :global(h3) {
    margin: 2.5rem 0 1rem;
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-weight: 500;
    line-height: 1.2;
    color: var(--ink);
  }
  .prose :global(h2) {
    font-size: clamp(1.6rem, 3vw, 2.1rem);
  }
  .prose :global(h3) {
    font-size: 1.4rem;
  }
  .prose :global(blockquote) {
    margin: 2.5rem 0;
    padding: 0.25rem 0 0.25rem 1.5rem;
    border-left: 3px solid var(--red);
    font-family: var(--font-body);
    font-style: italic;
    font-weight: 500;
    font-size: 1.35rem;
    line-height: 1.55;
    color: var(--ink);
  }
  .prose :global(blockquote p) {
    margin: 0;
  }
  .prose :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin: 2.5rem 0;
  }
  .prose :global(a) {
    color: var(--red-dark);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.5rem;
    padding-left: 1.4rem;
  }
  .article__back {
    display: inline-block;
    margin-top: 2.5rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .article__back:hover {
    color: var(--red);
  }

  .related {
    padding-block: clamp(3rem, 8vw, 6rem);
    background: var(--sand);
  }
  .related__title {
    margin: 0 0 clamp(2rem, 5vw, 3rem);
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-weight: 500;
    font-size: clamp(1.9rem, 4vw, 3rem);
    text-align: center;
  }
  .related__grid {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem) clamp(1.5rem, 3vw, 2.5rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
  }
</style>
