---
import Hero from './Hero.astro';
import data from '../data/gallery.json';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const photos = data.photos.map((p) => ({
  ...p,
  caption: lang === 'it' ? p.caption_it : p.caption_en,
}));
---

<Hero lang={lang} title={t('gallery.title')} eyebrow={t('gallery.eyebrow')} />

<section class="gallery" data-close={t('gallery.close')}>
  <div class="container">
    <div class="grid">
      {
        photos.map((p, i) => (
          <button
            type="button"
            class="tile reveal"
            style={`--reveal-delay: ${(i % 3) * 150}ms; aspect-ratio: ${p.width} / ${p.height}`}
            data-full={p.image}
            data-caption={p.caption}
            aria-label={`${t('gallery.open')}: ${p.caption}`}
          >
            <img src={p.image} alt={p.caption} width={p.width} height={p.height} loading="lazy" />
          </button>
        ))
      }
    </div>
  </div>
</section>

<dialog class="lightbox" aria-label={t('gallery.title')}>
  <button type="button" class="lightbox__btn lightbox__close" aria-label={t('gallery.close')}>×</button>
  <button type="button" class="lightbox__btn lightbox__prev" aria-label={t('gallery.prev')}>‹</button>
  <button type="button" class="lightbox__btn lightbox__next" aria-label={t('gallery.next')}>›</button>
  <figure class="lightbox__figure">
    <img class="lightbox__img" alt="" />
    <figcaption class="lightbox__caption"></figcaption>
  </figure>
</dialog>

<script>
  const root = document.querySelector<HTMLElement>('.gallery');
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
  if (root && dialog) {
    const tiles = Array.from(root.querySelectorAll<HTMLButtonElement>('.tile'));
    const img = dialog.querySelector<HTMLImageElement>('.lightbox__img')!;
    const caption = dialog.querySelector<HTMLElement>('.lightbox__caption')!;
    const visible = tiles;
    let index = 0;

    // Ingrandimento
    const show = (i: number) => {
      index = (i + visible.length) % visible.length;
      const tile = visible[index];
      img.src = tile.dataset.full ?? '';
      img.alt = tile.dataset.caption ?? '';
      caption.textContent = tile.dataset.caption ?? '';
    };
    const open = (tile: HTMLButtonElement) => {
      show(visible.indexOf(tile));
      dialog.showModal();
      document.documentElement.style.overflow = 'hidden';
    };
    tiles.forEach((tile) => tile.addEventListener('click', () => open(tile)));

    dialog.querySelector('.lightbox__close')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('.lightbox__prev')!.addEventListener('click', () => show(index - 1));
    dialog.querySelector('.lightbox__next')!.addEventListener('click', () => show(index + 1));
    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
    });
    // clic sullo sfondo scuro = chiudi
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
    // swipe su touch
    let startX = 0;
    dialog.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
    dialog.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
    });
  }
</script>

<style>
  .gallery {
    padding-block: clamp(3rem, 8vw, 6rem);
  }
  /* Griglia a colonne: le foto mantengono il loro formato */
  .grid {
    columns: 1;
    column-gap: clamp(0.75rem, 2vw, 1.25rem);
  }
  @media (min-width: 560px) {
    .grid {
      columns: 2;
    }
  }
  @media (min-width: 960px) {
    .grid {
      columns: 3;
    }
  }
  .tile {
    display: block;
    width: 100%;
    margin: 0 0 clamp(0.75rem, 2vw, 1.25rem);
    padding: 0;
    border: 0;
    background: var(--sand);
    overflow: hidden;
    cursor: zoom-in;
    break-inside: avoid;
  }
  .tile img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .tile:hover img,
  .tile:focus-visible img {
    transform: scale(1.05);
  }
  .tile:focus-visible {
    outline: 3px solid var(--red);
    outline-offset: 2px;
  }

  /* Ingrandimento */
  .lightbox {
    width: 100vw;
    max-width: none;
    height: 100vh;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(12, 8, 8, 0.94);
    color: #fff;
  }
  .lightbox::backdrop {
    background: rgba(12, 8, 8, 0.94);
  }
  .lightbox[open] {
    display: grid;
    place-items: center;
  }
  .lightbox__figure {
    margin: 0;
    max-width: min(92vw, 1400px);
    display: grid;
    gap: 0.9rem;
    justify-items: center;
  }
  .lightbox__img {
    display: block;
    max-width: 100%;
    max-height: 82vh;
    max-height: 82dvh;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .lightbox__caption {
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.95rem;
    text-align: center;
  }
  .lightbox__btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s;
  }
  .lightbox__btn:hover {
    background: var(--red);
  }
  .lightbox__close {
    top: 1rem;
    right: 1rem;
  }
  .lightbox__prev {
    left: 1rem;
    top: 50%;
    translate: 0 -50%;
  }
  .lightbox__next {
    right: 1rem;
    top: 50%;
    translate: 0 -50%;
  }
</style>
