---
import { render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import NewsArticle from '../../../components/NewsArticle.astro';
import { getNews, newsSlug } from '../../../lib/news';

export async function getStaticPaths() {
  const posts = await getNews('en');
  return posts.map((entry) => ({ params: { slug: newsSlug(entry) }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={`${entry.data.title} | Rabboni Performance Horses`} description={entry.data.excerpt} transparentHeader>
  <NewsArticle entry={entry} lang="en">
    <Content />
  </NewsArticle>
</Layout>
