---
import { render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import StallionDetail from '../../../components/StallionDetail.astro';
import { getStallions, stallionSlug } from '../../../lib/stallions';

export async function getStaticPaths() {
  const stallions = await getStallions('en');
  return stallions.map((entry) => ({ params: { slug: stallionSlug(entry) }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={`${entry.data.name} | Rabboni Performance Horses`} description={entry.data.excerpt} transparentHeader>
  <StallionDetail entry={entry} lang="en">
    <Content />
  </StallionDetail>
</Layout>
